NODE_ENV=production
PUBLIC_BASE_URL=https://learn.educlub.co.ke
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
DB_POOL_MAX=4
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_LOGS=false

JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

FRONTEND_URL=https://educlub.co.ke
CORS_ORIGINS=https://educlub.co.ke,https://www.educlub.co.ke

EMAIL_HOST=mail.educlub.co.ke
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=noreply@educlub.co.ke
EMAIL_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD
EMAIL_FROM=eduClub <noreply@educlub.co.ke>
EMAIL_REPLY_TO=support@educlub.co.ke

SYSTEM_ADMIN_EMAIL=REPLACE_WITH_SYSTEM_ADMIN_EMAIL
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_TEMPORARY_PASSWORD
DEFAULT_SCHOOL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_TEMPORARY_PASSWORD
DEFAULT_LEARNER_PASSWORD=REPLACE_WITH_STRONG_TEMPORARY_PASSWORD

STANDALONE_LMS_ENABLED=true

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
