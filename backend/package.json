{
  "name": "educlub-backend",
  "version": "1.0.0",
  "description": "eduClub LMS Backend - Lightweight standalone school learning platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --require ./test/setup-env.js --test test/*.test.js",
    "test:integration": "node --require ./test/setup-env.js --test test/integration/*.test.js",
    "email:verify": "node scripts/verify-email.js",
    "schema:ensure": "node scripts/ensure-startup-schema.js",
    "db:migrate": "node scripts/mysql-migration/apply-schema.js",
    "db:migrate:status": "node scripts/mysql-migration/apply-schema.js",
    "db:health": "node src/database/health.js",
    "lint": "eslint src test",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "validate": "npm run lint && npm test",
    "migrate": "node ../scripts/migrate.js",
    "seed": "node ../scripts/seed-admin.js",
    "seed:weekly-learning": "node scripts/seed-weekly-learning-content.js",
    "import:web-development-1": "node scripts/import-web-development-1.js",
    "import:scratch-pathway": "node scripts/import-scratch-pathway.js",
    "db:apply-schema": "node scripts/mysql-migration/apply-schema.js",
    "db:translate-schema": "node scripts/mysql-migration/translate-schema.js",
    "db:seed-admin": "node scripts/mysql-migration/seed-admin.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.5.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.23.4",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.0",
    "speakeasy": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "nodemon": "^3.0.1"
  }
}
